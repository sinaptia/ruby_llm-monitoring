source "https://rubygems.org"

gemspec path: ".."

gem "rails", "~> 8.0.0"

gem "puma"

gem "mysql2"
gem "pg"
gem "sqlite3"
gem "trilogy"

gem "propshaft"

# Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
gem "rubocop-rails-omakase", require: false

gem "dotenv"

gem "minitest", "< 6.0"
gem "vcr"
gem "webmock"

# Start debugger with binding.b [https://github.com/ruby/debug]
gem "debug", ">= 1.0.0"
